{
  "manifest_version": 3,
  "name": "Start Page",
  "short_name": "Start Page",
  "version": "1.12.0",
  "description": "A calm, local-first new tab page: clocks, smart web/AI/academic search, shortcuts and a launcher dock.",
  "minimum_chrome_version": "104",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "favicon"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
